# Copy this file to .env and replace each required placeholder with a unique secret.
# Do not commit .env or share its contents.

# Required. Generate a unique administrator PIN with at least 16 characters.
ADMIN_SECRET_PIN=replace-with-a-random-admin-pin-at-least-16-characters

# Required. Generate a separate random secret with at least 32 bytes of entropy.
NKOCET_CRYPTO_SECRET=replace-with-a-random-64-character-hex-secret

# Optional. Set both SMTP values to enable real Gmail OTP delivery.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=NKOCET Solapur Verification Gateway

# Optional. Use an absolute path on a persistent Render disk, for example
# /var/data/associationhub.db. If unset, the local associationhub.db is used.
DATABASE_PATH=

# Optional proxy configuration. On Render, RENDER=true enables safe handling
# of the platform proxy. Otherwise, set only networks controlled by this service.
RENDER=false
TRUSTED_PROXY_IPS=

# Required before issuing/retrieving passes. Use the public GitHub Pages site
# root (including its repository path if this is a project site), not the API host.
PUBLIC_APP_URL=
